# Required: API key accepted by your own CLIProxyAPI instance.
CPA_API_KEY=
CPA_BASE=http://127.0.0.1:8317/v1
IMAGE_MODEL=gpt-image-2

# Replace this example with the public HTTPS hostname you control (no scheme/path).
PUBLIC_HOST=images.example.com

# install.sh fills these with independent random values. Never commit real values.
MCP_TOKEN=
DOWNLOAD_SIGNING_KEY=

# Optional fallback: leave empty to use request-header authentication only.
MCP_SECRET=

DOWNLOAD_TTL_HOURS=72
IMAGE_RETENTION_DAYS=3
DAILY_LIMIT=40
PREVIEW_PX=512
PORT=8787
TZ_NAME=Asia/Shanghai
IMAGE_DIR=/var/lib/cpa-image-mcp/images
